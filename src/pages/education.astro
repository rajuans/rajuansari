---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';

const education = [
  {
    institution: 'Banaras Hindu University',
    degree: 'Master of Computer Application',
    field: 'Computer Science',
    period: '2004 — 2007',
    location: 'Varanasi, India',
    highlights: [
    
    ],
  },
];
---

<Base title="Education" description="Academic background and education of Raju Ansari.">
  <Nav />
  <main class="max-w-4xl mx-auto w-full px-6 flex-1 py-12">

    <PageHeader
      title="Education"
      eyebrow="Academic Background"
    />

    <div class="space-y-3">
      {education.map(edu => (
        <div class="reveal p-5 border border-gray-200 dark:border-neutral-800 rounded-lg">
          <div class="flex items-start justify-between mb-3">
            <div>
              <h2 class="text-sm font-medium text-gray-900 dark:text-neutral-100">
                {edu.degree} in {edu.field}
              </h2>
              <p class="text-xs text-gray-500 dark:text-neutral-400 mt-0.5">{edu.institution} · {edu.location}</p>
            </div>
            <span class="text-xs text-[var(--accent)] font-mono shrink-0 ml-4">{edu.period}</span>
          </div>
          {edu.highlights.length > 0 && (
            <ul class="space-y-1.5 mt-4 pt-4 border-t border-gray-100 dark:border-neutral-800">
              {edu.highlights.map(h => (
                <li class="flex gap-2 text-sm text-gray-500 dark:text-neutral-400">
                  <span class="text-[var(--accent)] shrink-0">–</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>

  </main>
  <Footer />
</Base>
