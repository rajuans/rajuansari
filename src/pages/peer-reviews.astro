---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';

const reviews = [
  {
    venue: '2nd International Conference on Big Data Science and Engineering',
    shortName: 'ICBDSE 2025',
    type: 'Conference',
    org: 'IEEE',
    year: '2025',
    notes: 'Invited reviewer in recognition of contributions to the conference review process.',
    papers: [],
  },
  {
    venue: 'International Conference on Advanced Machine Learning and Data Science',
    shortName: 'AMLDS 2025',
    type: 'Conference',
    org: 'IEEE',
    year: '2025',
    notes: 'Invited reviewer in recognition of contributions to the conference review process.',
    papers: [],
  },
  {
    venue: 'International Conference on Information Technology, Computer and Communication',
    shortName: 'ICITCOM 2025',
    type: 'Conference',
    org: 'IEEE #66635',
    year: '2025',
    notes: 'Hybrid conference held Aug 6–7, 2025 at Universitas Muhammadiyah Yogyakarta, Indonesia.',
    papers: [],
  },
  {
    venue: 'Think Distributed Systems — Manning Publications',
    shortName: 'Book Review',
    type: 'Book',
    org: 'Manning',
    year: '2025',
    notes: 'Participated in multiple manuscript review rounds of "Think Distributed Systems" by Dominik Tornow. Certified reviewer and ongoing member of the Manning reviewer community.',
    papers: [],
  },
];
---

<Base title="Peer Reviews" description="Peer review activities by Raju Ansari.">
  <Nav />
  <main class="max-w-4xl mx-auto w-full px-6 flex-1 py-12">

    <PageHeader
      title="Peer Reviews"
      eyebrow="Academic Service"
      count={String(reviews.length)}
      description="venues reviewed for across IEEE conferences and technical publications."
    />

    <div class="space-y-3">
      {reviews.map(review => (
        <div class="reveal p-5 border border-gray-200 dark:border-neutral-800 rounded-lg">

          <!-- Header -->
          <div class="flex items-start justify-between gap-3 mb-3">
            <div class="flex items-start gap-2 flex-wrap">
              <div>
                <span class="text-sm font-medium text-gray-900 dark:text-neutral-100">{review.venue}</span>
                <div class="flex items-center gap-2 mt-1">
                  <span class="px-2 py-0.5 text-xs bg-[var(--accent-dim)] text-[var(--accent)] rounded font-mono">
                    {review.type}
                  </span>
                  <span class="text-xs text-gray-400 dark:text-neutral-500 font-mono">{review.org}</span>
                  {review.papers.length > 0 && (
                    <span class="text-xs text-gray-400 dark:text-neutral-500 font-mono">· {review.papers.length} paper{review.papers.length !== 1 ? 's' : ''} reviewed</span>
                  )}
                </div>
              </div>
            </div>
            <span class="text-xs text-[var(--accent)] font-mono shrink-0">{review.year}</span>
          </div>

          <!-- Notes -->
          {review.notes && (
            <p class="text-sm text-gray-500 dark:text-neutral-400 leading-relaxed mb-3">{review.notes}</p>
          )}

          <!-- Reviewed papers -->
          {review.papers.length > 0 && (
            <div class="mt-3 pt-3 border-t border-gray-100 dark:border-neutral-800 space-y-2">
              {review.papers.map(paper => (
                <div class="flex items-start gap-2">
                  <span class="text-[var(--accent)] shrink-0 mt-0.5 text-xs">—</span>
                  <div>
                    <p class="text-xs text-gray-600 dark:text-neutral-300">{paper.title}</p>
                    <p class="text-xs text-gray-400 dark:text-neutral-500 font-mono mt-0.5">{paper.id}</p>
                  </div>
                </div>
              ))}
            </div>
          )}

        </div>
      ))}
    </div>

  </main>
  <Footer />
</Base>
