---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';

const press = [
  {
    outlet: 'TechCrunch',
    type: 'Article',
    year: '2025',
    title: 'Article or interview title here',
    description: 'A short description of what the piece covers and why it was noteworthy.',
    href: '#',
    action: 'Read',
  },
  {
    outlet: 'The Changelog',
    type: 'Podcast',
    year: '2024',
    title: 'Podcast episode title here',
    description: 'A short description of the episode and what topics were covered.',
    href: '#',
    action: 'Listen',
  },
  {
    outlet: 'Wall Street Journal',
    type: 'Feature',
    year: '2024',
    title: 'Featured article title here',
    description: 'A brief summary of the feature and what was discussed.',
    href: '#',
    action: 'Read',
  },
  {
    outlet: 'YouTube',
    type: 'Talk',
    year: '2023',
    title: 'Conference talk or interview title',
    description: 'What the talk was about and where it was presented.',
    href: '#',
    action: 'Watch',
  },
];
---

<Base title="Press" description="Media coverage, interviews, and press mentions of Raju Ansari.">
  <Nav />
  <main class="max-w-4xl mx-auto w-full px-6 flex-1 py-12">

    <PageHeader
      title="Press"
      eyebrow="Media & Coverage"
      count={`${press.length}+ outlets`}
      description={`— ${press.map(p => p.outlet).join(' · ')}`}
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {press.map(item => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class="reveal group flex flex-col p-5 border border-gray-200 dark:border-neutral-800 rounded-lg hover:border-[var(--accent)] transition-colors"
        >
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
              <span class="text-xs font-medium text-gray-900 dark:text-neutral-100">{item.outlet}</span>
              <span class="px-2 py-0.5 text-xs bg-[var(--accent-dim)] text-[var(--accent)] rounded font-mono">
                {item.type}
              </span>
            </div>
            <span class="text-xs text-gray-400 dark:text-neutral-500">{item.year}</span>
          </div>

          <div class="flex-1">
            <h3 class="text-sm font-medium text-gray-900 dark:text-neutral-100 group-hover:text-[var(--accent)] transition-colors leading-snug mb-2">
              {item.title}
            </h3>
            <p class="text-sm text-gray-500 dark:text-neutral-400 leading-relaxed">{item.description}</p>
          </div>

          <div class="flex items-center justify-between mt-4 pt-4 border-t border-gray-100 dark:border-neutral-800">
            <span class="text-xs font-medium text-[var(--accent)]">
              {item.action} →
            </span>
          </div>
        </a>
      ))}
    </div>

  </main>
  <Footer />
</Base>
