---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';

const press = [
  // AgentCore Payments launch — AWS × Coinbase × Stripe (2026)
  { outlet: 'AI Business',      type: 'Article', year: '2026', title: 'AWS Launches Agentic AI Payment Capabilities', href: '#', action: 'Read' },
  { outlet: 'AI Magazine',      type: 'Article', year: '2026', title: 'AWS, Coinbase & Stripe Launch Autonomous Paying AI Agents', href: '#', action: 'Read' },
  { outlet: 'AI World Today',   type: 'Article', year: '2026', title: 'Agents that transact: Introducing AgentCore payments, built with Coinbase and Stripe', href: '#', action: 'Read' },
  { outlet: 'BizSugar',         type: 'Article', year: '2026', title: 'Stripe Teams Up with AWS to Enhance AgentCore Payments via Privy', href: '#', action: 'Read' },
  { outlet: 'Bitcoin News',     type: 'Article', year: '2026', title: 'Coinbase Gives Amazon Bedrock Agents Wallet Tools With USDC Settlement', href: '#', action: 'Read' },
  { outlet: 'The Block',        type: 'Article', year: '2026', title: 'AWS taps Coinbase and Stripe to power USDC payments for AI agents', href: '#', action: 'Read' },
  { outlet: 'CoinDesk',         type: 'Article', year: '2026', title: "Amazon's new AI wallet: AWS, Coinbase, and Stripe build payment rails for bots", href: '#', action: 'Read' },
  { outlet: 'CoinLaw',          type: 'Article', year: '2026', title: 'AWS Partners Coinbase and Stripe for Agentic Stablecoin Payments', href: '#', action: 'Read' },
  { outlet: 'Crypto Briefing',  type: 'Article', year: '2026', title: 'Coinbase and AWS bring USDC payments to enterprise AI agents', href: '#', action: 'Read' },
  { outlet: 'CryptoCompass',    type: 'Article', year: '2026', title: 'AI Agents Just Got Their Own Wallets Powered By Coinbase', href: '#', action: 'Read' },
  { outlet: 'Crypto Times',     type: 'Article', year: '2026', title: 'Coinbase and AWS Bridge AI and Crypto With USDC Payments', href: '#', action: 'Read' },
  { outlet: 'The Cryptonist',   type: 'Article', year: '2026', title: 'Coinbase AWS USDC payments bring micropayments to Bedrock AgentCore', href: '#', action: 'Read' },
  { outlet: 'Decrypt',          type: 'Article', year: '2026', title: 'Amazon Teams With Coinbase and Stripe to Let AI Agents Pay With Stablecoins', href: '#', action: 'Read' },
  { outlet: 'The Defiant',      type: 'Article', year: '2026', title: 'Amazon Builds AI Agent Payments With Coinbase and Stripe', href: '#', action: 'Read' },
  { outlet: 'FX News Group',    type: 'Article', year: '2026', title: 'Stripe teams up with AWS to power AgentCore payments with Privy', href: '#', action: 'Read' },
  { outlet: 'PYMNTS',           type: 'Article', year: '2026', title: 'Amazon Bedrock Launches AI Agent Payment Capabilities With Coinbase, Stripe', href: '#', action: 'Read' },
  { outlet: 'Ledger Insights',  type: 'Article', year: '2026', title: 'AWS unveils AI agent payments based on stablecoins', href: '#', action: 'Read' },
  { outlet: 'Time.News',        type: 'Article', year: '2026', title: 'AWS Launches AgentCore Payments: AI Agents Now Transact in Real-Time With Stripe & Coinbase', href: '#', action: 'Read' },
  { outlet: 'Yahoo! Tech',      type: 'Article', year: '2026', title: 'Amazon Teams With Coinbase and Stripe to Let AI Agents Pay With Stablecoins', href: '#', action: 'Read' },
  { outlet: 'Yellow',           type: 'Article', year: '2026', title: "AI Agents Can Now Pay In USDC On AWS, Thanks To Coinbase's x402", href: '#', action: 'Read' },
  // Alexa — Voice Recognition & Personalization
  { outlet: 'CNET',             type: 'Article', year: '2021', title: 'On Echo Show 15, Alexa Will Recognize Your Face Thanks to Visual ID', href: '#', action: 'Read' },
  { outlet: 'Amazon Science',   type: 'Article', year: '2021', title: 'Ambient Intelligence Will Accelerate Advancements in General AI', href: '#', action: 'Read' },
  { outlet: 'Good Morning America', type: 'Video', year: '2019', title: 'Alexa Voice PIN & Authentication', href: '#', action: 'Watch' },
  { outlet: 'ZDNet',            type: 'Article', year: '2019', title: "Alexa Skills Can Now Recognise Your Voice to Personalise Services", href: '#', action: 'Read' },
  { outlet: 'Wall Street Journal', type: 'Video', year: '2017', title: 'Alexa Voice Recognition Launch Coverage', href: 'https://youtube.com/watch?v=z3rCa0VL4AE', action: 'Watch' },
  { outlet: 'TechCrunch',       type: 'Article', year: '2017', title: 'Amazon Alexa Devices Can Finally Distinguish Between Different Voices', href: '#', action: 'Read' },
  { outlet: 'TIME',             type: 'Article', year: '2017', title: 'Amazon Echo Voice ID Feature', href: '#', action: 'Read' },
  { outlet: 'The Verge',        type: 'Article', year: '2017', title: 'Amazon Echo Multi-User Voice Recognition', href: '#', action: 'Read' },
  { outlet: 'Business Insider', type: 'Article', year: '2015', title: 'Amazon Introduces Amazon Home Services', href: '#', action: 'Read' },
];
---

<Base title="Press" description="Media coverage, interviews, and press mentions of Raju Ansari.">
  <Nav />
  <main class="max-w-4xl mx-auto w-full px-6 flex-1 py-12">

    <PageHeader
      title="Press"
      eyebrow="Media & Coverage"
      count={String(press.length)}
      description="outlets covering AgentCore Payments, Alexa Voice ID, and more."
    />

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2">
      {press.map(item => (
        <a
          href={item.href}
          target={item.href !== '#' ? '_blank' : undefined}
          rel={item.href !== '#' ? 'noopener noreferrer' : undefined}
          class="reveal group flex flex-col p-3 border border-gray-200 dark:border-neutral-800 rounded-lg hover:border-[var(--accent)] transition-colors"
        >
          <div class="flex items-start justify-between gap-1 mb-2">
            <span class="text-xs font-medium text-gray-900 dark:text-neutral-100 leading-tight">{item.outlet}</span>
            <span class="text-xs text-gray-400 dark:text-neutral-500 shrink-0 ml-1">{item.year}</span>
          </div>

          <p class="flex-1 text-xs text-gray-600 dark:text-neutral-300 leading-snug mb-3">
            {item.title}
          </p>

          <div class="flex items-center justify-between">
            <span class="px-1.5 py-0.5 text-[10px] bg-[var(--accent-dim)] text-[var(--accent)] rounded font-mono">
              {item.type}
            </span>
            <span class="text-xs font-medium text-[var(--accent)]">
              {item.action} →
            </span>
          </div>
        </a>
      ))}
    </div>

  </main>
  <Footer />
</Base>
